# Circuit Breaker Configuration
# DEFAULT MODE = SAFE MOCK. Real Sepolia is opt-in only.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required for HMAC authorization tokens. Never commit a production secret.
SECRET_KEY=replace-with-secure-secret

# Policy Configuration
MAX_SINGLE_TRANSFER=10000
DAILY_VELOCITY_LIMIT=20000
NEW_COUNTERPARTY_THRESHOLD=1000
DUPLICATE_WINDOW_MINUTES=15
HIGH_RISK_THRESHOLD=0.85

# Sepolia (opt-in). Leave false / empty for judges and CI.
ENABLE_TESTNET_EXECUTION=false
TESTNET_RPC_URL=
TESTNET_CHAIN_ID=11155111
TESTNET_PRIVATE_KEY=

# TrueForge (optional). Demo scripts do not require this.
TRUEFORGE_API_KEY=
